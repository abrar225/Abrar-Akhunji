{
  "name": "abrar-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://abrarakhunji.com",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/build-blog-index.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-blog-index.mjs",
    "build": "vite build && node scripts/generate-seo.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "pretest": "node scripts/build-blog-index.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "validate:content": "node scripts/build-blog-index.mjs --check",
    "deploy:hostinger": "npm run build && node scripts/deploy-hostinger.mjs",
    "test:design": "node tests/e2e/design.mjs",
    "test:editorial": "npm run build && node tests/e2e/editorial.mjs",
    "test:polish": "npm run build && node tests/e2e/polish.mjs",
    "test:workshop": "node tests/e2e/workshop.mjs",
    "github:refresh": "node scripts/fetch-github.mjs",
    "assets:render": "ego-browser nodejs < tools/export-build-room-assets.mjs",
    "assets:optimize": "uv run --with pillow --with fonttools --with brotli python scripts/prepare-room-assets.py && uv run --with pillow python scripts/asset-manifest.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "framer-motion": "^12.23.24",
    "gsap": "^3.14.2",
    "katex": "^0.18.5",
    "lenis": "^1.3.17",
    "lucide-react": "^0.554.0",
    "marked": "^18.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.17",
    "tus-js-client": "^4.3.1",
    "vite": "^6.0.0"
  }
}
