{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "src/agents/entry.jsx",
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.{js,jsx,ts,tsx}"
  ],
  "ignore": [
    "docs/**",
    "_reference-repos/**"
  ],
  "ignoreDependencies": [
    "tailwindcss"
  ],
